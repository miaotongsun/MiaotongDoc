# ================================================================
# MiaotongDoc 环境变量模板
# ================================================================
# 使用说明：
#   1. 复制此文件：cp .env.example .env
#   2. 修改 .env 中的所有密码和密钥（不要使用默认值）
#   3. 启动服务：./deploy.sh start
#
# 安全提示：
#   - 所有密码和密钥必须在生产环境中修改
#   - .env 文件包含敏感信息，不要提交到 Git
#   - 建议密码长度 >= 16 位，包含大小写字母、数字和特殊字符
# ================================================================


# ===== 数据库配置 =====
# PostgreSQL 数据库名称（自动创建，无需修改）
POSTGRES_DB=miaotongdocdb

# PostgreSQL 数据库用户（自动创建，无需修改）
POSTGRES_USER=miaotong

# PostgreSQL 数据库密码
# 用于：postgres 容器、web-server 连接数据库、editor 连接数据库
# 要求：长度 >= 8 位，生产环境建议 16 位以上
DB_PASSWORD=your_db_password_here


# ===== Redis 配置 =====
# Redis 缓存密码
# 用于：redis 容器、web-server 连接 Redis、editor 连接 Redis
# 要求：长度 >= 8 位
REDIS_PASSWORD=your_redis_password_here


# ===== RabbitMQ 配置 =====
# RabbitMQ 消息队列密码
# 用于：rabbitmq 容器、editor 连接 RabbitMQ（协同编辑消息传递）
# 要求：长度 >= 8 位
RABBITMQ_PASSWORD=your_rabbitmq_password_here


# ===== OnlyOffice 安全链接密钥 =====
# OnlyOffice 文档服务器的安全链接密钥
# 用于：editor 容器内部文件访问签名
# 要求：长度 >= 16 位，生产环境建议修改
SECURE_LINK_SECRET=your_secure_link_secret_here


# ===== 应用 JWT 配置 =====
# 后端应用的 JWT 签名密钥
# 用于：用户登录 Token 签发和验证
# 要求：长度 >= 32 位，生产环境必须修改
APP_JWT_SECRET=your_app_jwt_secret_min_32_chars_here

# JWT Token 过期时间（毫秒）
# 默认：7200000ms = 2 小时
# 可选值：3600000（1小时）、7200000（2小时）、86400000（24小时）
APP_JWT_EXPIRATION=7200000


# ===== 编辑器 JWT 配置 =====
# OnlyOffice 编辑器的 JWT 签名密钥
# 用于：后端与 OnlyOffice 编辑器之间的 Token 验证
# 要求：长度 >= 32 位，生产环境必须修改
# 注意：此密钥必须与 OnlyOffice 编辑器配置一致
EDITOR_JWT_SECRET=your_editor_jwt_secret_min_32_chars_here


# ===== 跨域配置 =====
# 允许的前端访问来源（CORS）
# 用于：浏览器跨域请求验证
# 格式：多个域名用逗号分隔，不要有空格
# 示例：https://doc.bank.com,https://admin.bank.com
# 开发环境：http://localhost
# 生产环境：https://你的域名
CORS_ORIGINS=https://doc.bank.com


# ===== SSO 单点登录配置（可选）=====
# 是否启用 SSO 单点登录
# 可选值：true（启用）、false（禁用）
SSO_ENABLED=false

# SSO 提供商显示名称
# 用于：登录页面显示的 SSO 按钮文字
SSO_PROVIDER_NAME=统一认证

# SSO 服务器地址（SSO 启用时必填）
# 示例：https://sso.bank.com/realms/miaotong
SSO_ISSUER_URI=https://sso.bank.com/realms/miaotong

# SSO 客户端 ID（SSO 启用时必填）
# 示例：miaotongdoc
SSO_CLIENT_ID=miaotongdoc

# SSO 客户端密钥（SSO 启用时必填）
SSO_CLIENT_SECRET=your_sso_client_secret_here

# SSO 自动创建用户（SSO 启用时可选）
# 可选值：true（自动创建）、false（不自动创建）
SSO_AUTO_PROVISION=true

# SSO 登录成功后跳转地址
SSO_SUCCESS_REDIRECT=/home.html

# SSO 登录失败后跳转地址
SSO_FAILURE_REDIRECT=/login.html?error=sso_failed


# ===== 存储配置 =====
# 文档存储类型
# 可选值：
#   local - 本地文件系统（开发环境、单机部署）
#   minio - MinIO 对象存储（生产环境、多机部署）
#
# local 模式：文件存储在 data/documents/ 目录
# minio 模式：文件存储在 MinIO 服务中
STORAGE_TYPE=minio

# MinIO 访问密钥（storage.type=minio 时必填）
# 用于：MinIO 控制台登录、API 访问认证
# 要求：长度 >= 8 位
MINIO_ACCESS_KEY=your_minio_access_key

# MinIO 秘密密钥（storage.type=minio 时必填）
# 用于：MinIO API 访问认证
# 要求：长度 >= 8 位，生产环境必须修改
MINIO_SECRET_KEY=your_minio_secret_key

# MinIO 存储桶名称（storage.type=minio 时必填）
# 用于：存储文档文件的 MinIO 桶
# 命名规则：小写字母、数字、连字符，长度 3-63 位
MINIO_BUCKET=miaotongdoc


# ===== 缓存清理配置 =====
# OnlyOffice 编辑器缓存最大保留时间（小时）
# 用于：cache-cleaner 容器自动清理过期缓存
# 默认：24 小时
# 缓存目录：data/editor-cache/（临时编辑文件、已关闭文档残留文件）
CACHE_MAX_AGE_HOURS=24

# ===== AI 大模型配置（可选）=====
# 内网大模型 API 地址（OpenAI 兼容格式）
# 示例：http://192.168.1.100:8080
# 用于：AI 插件代理转发，配置后 AI 插件的请求将通过后端代理转发到此地址
LLM_API_URL=

# 大模型 API 密钥（如无需密钥可留空）
LLM_API_KEY=

# 大模型 API 超时时间（秒）
# 默认：300 秒
LLM_TIMEOUT=300

# ===== Docling 文档解析配置 =====
# Docling 服务地址（用于 PDF 结构化识别，Docker 内部地址）
# 修改：部署到内网时,若 docling 容器改名或换地址,改这里
# 默认：http://docling:5001
DOCLING_SERVER_URL=http://docling:5001

# 是否启用 Docling（true/false）
# 启用后 PDF 文本提取将走 Docling → PaddleOCR → Tesseract → PDFBox 四层瀑布
# 关闭后跳过 Docling,直接从 PaddleOCR 开始
# 容器启动：docker compose --profile docling up -d docling（或 --profile all）
# 模型已烧入镜像(~506MB),内网环境零外网请求（HF_HUB_OFFLINE=1）
# 默认：false
DOCLING_ENABLED=false

# Docling 请求超时时间（秒）
# 默认：300 秒（大文档解析较慢,生产建议 600）
DOCLING_TIMEOUT=300

# Docling 内置 OCR 的 Tesseract 语言包（多个用 + 连接）
# chi_sim=简体中文, chi_tra=繁体中文, eng=英文, jpn=日文, kor=韩文
# 默认：chi_sim+eng
DOCLING_OCR_LANGUAGES=chi_sim+eng


# ===== Tesseract OCR 服务配置（多语言兜底,默认禁用） =====
# Tesseract 服务地址（Docker 内部地址,通常无需修改）
# 默认：http://ocr:5002
OCR_SERVER_URL=http://ocr:5002

# 是否启用 Tesseract（true/false）
# 启用后扫描件 PDF 识别会走到 Tesseract 兜底
# 容器启动：docker compose --profile ocr up -d ocr（或 --profile all）
# tessdata 由 apt 包自带,内网环境无需外网
# 默认：false
OCR_ENABLED=false

# Tesseract 语言包配置（运行时动态安装,内置 chi_sim+eng）
# 格式：tesseract 语言代码,用 + 连接
# 可选值：chi_sim/eng/jpn/kor/chi_tra/fra/deu/rus/spa/por/ita 等
# 注意：动态安装需要 apt 源可达,纯离线部署建议在 Dockerfile 预装
# 默认：chi_sim+eng
OCR_LANGUAGES=chi_sim+eng


# ===== PaddleOCR 中文扫描件主力配置（默认启用） =====
# PaddleOCR 服务地址（Docker 内部地址,通常无需修改）
# 默认：http://ocr-paddle:5003
PADDLE_OCR_SERVER_URL=http://ocr-paddle:5003

# 是否启用 PaddleOCR（true/false）
# 启用后中文扫描件 PDF 识别走 PaddleOCR(主力)
# 模型已烧入镜像(~232MB),内网环境零外网请求
# （PADDLE_PDX_DISABLE_REMOTE=1 + PADDLEX_DISABLE_REMOTE_SOURCE=1 已硬编码在 Dockerfile）
# 默认：true（如需节省内存可设 false）
PADDLE_OCR_ENABLED=true

# PaddleOCR 语言
# 可选值：ch=简体中文(默认) / en=英文 / japan=日文 / korean=韩文
# 默认：ch
PADDLE_OCR_LANGUAGE=ch

# PaddleOCR 请求超时时间（秒）
# 单 PDF 单引擎上限,长文档适当调大
# 默认：600 秒
PADDLE_OCR_TIMEOUT=600

# PaddleOCR 默认模型档（mobile=轻量快,server=高精度慢）
# 可选值：mobile / server
# 前端 PDF 编辑器 → 识别 按钮组显式选档,此处只决定"自动识别"路由的默认档
# 默认：mobile
PADDLE_OCR_DEFAULT_MODEL=mobile

# PaddleOCR 表格识别（PP-Structure）
# 关闭后 PDF 中的表格不会被结构化识别,识别结果只含纯文本
# 默认：true
PADDLE_OCR_USE_TABLE=true

# PaddleOCR 版面分析（layout）
# 关闭后识别结果按检测顺序拼接,不做段落重建
# 默认：true
PADDLE_OCR_USE_LAYOUT=true

# PaddleOCR 返回文字坐标（bbox）
# 前端 OCR 叠加框选复制依赖此开关;关闭后无法框选
# 默认：true
PADDLE_OCR_RETURN_COORDS=true


# ===== OCR 引擎开关组合速查 =====
# 场景 1（推荐）：完整四层瀑布,适合生产
#   DOCLING_ENABLED=true PADDLE_OCR_ENABLED=true OCR_ENABLED=true
#   启动：docker compose --profile all up -d
# 场景 2：仅中文扫描件主力,最常用
#   DOCLING_ENABLED=false PADDLE_OCR_ENABLED=true OCR_ENABLED=false
#   启动：docker compose up -d ocr-paddle
# 场景 3：纯 PDFBox（无任何 OCR 服务,适合纯文本 PDF 环境）
#   DOCLING_ENABLED=false PADDLE_OCR_ENABLED=false OCR_ENABLED=false
#   启动：docker compose up -d（不需要任何 OCR profile）
# 场景 4：内网离线环境（默认配置即可）
#   所有 OCR 模型已烧入镜像,无需 HF/PaddleX 外网请求
#   详见 plans/2026-07-26-offline-deployment.md
